{
  "name": "import-ladder",
  "displayName": "Sort Imports Ladder",
  "description": "Sort TypeScript and JavaScript imports as a ladder: shortest line first, longest last. Works before or after Prettier, in VS Code and Cursor.",
  "version": "0.3.3",
  "publisher": "kyoresuas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyoresuas/import-ladder.git"
  },
  "homepage": "https://github.com/kyoresuas/import-ladder#readme",
  "bugs": {
    "url": "https://github.com/kyoresuas/import-ladder/issues"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1b1d27",
    "theme": "dark"
  },
  "keywords": [
    "sort imports",
    "import sorter",
    "import ladder",
    "imports ladder",
    "staircase imports",
    "organize imports",
    "sort by length",
    "typescript",
    "javascript",
    "react",
    "prettier",
    "cursor",
    "лесенка импортов"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sortImport.sort",
        "title": "Sort Imports Ladder"
      }
    ],
    "configuration": {
      "title": "Sort Imports Ladder",
      "properties": {
        "sortImport.formatOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically sort imports when saving a file."
        },
        "sortImport.printWidth": {
          "type": "number",
          "default": 80,
          "description": "Max line width before an import is broken into multiple lines."
        },
        "sortImport.indentSize": {
          "type": "number",
          "default": 2,
          "description": "Indent size (in spaces) for multi-line imports."
        },
        "sortImport.useTabs": {
          "type": "boolean",
          "default": false,
          "description": "Use tab characters for indentation in multi-line imports."
        },
        "sortImport.quote": {
          "type": "string",
          "enum": [
            "\"",
            "'"
          ],
          "default": "\"",
          "description": "Quote style for module strings."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.140.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
